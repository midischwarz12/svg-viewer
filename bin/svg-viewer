#!/usr/bin/env node
// SPDX-License-Identifier: AGPL-3.0-only

const fs = require("node:fs");
const http = require("node:http");
const net = require("node:net");
const os = require("node:os");
const path = require("node:path");
const { spawn } = require("node:child_process");

function usage() {
  console.error(`Usage: svg-viewer [--interval SECONDS] <path-to-svg>

Open an SVG in your preferred browser and refresh it on a timer.`);
}

function htmlEscape(value) {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");
}

function isPositiveNumber(value) {
  return /^[0-9]+([.][0-9]+)?$/.test(value) && Number(value) > 0;
}

function stripXmlPreamble(svg) {
  return svg
    .replace(/^\s*<\?xml\b[^>]*>\s*/i, "")
    .replace(/^\s*<!DOCTYPE\b(?:[^>"']|"[^"]*"|'[^']*')*>\s*/i, "");
}

function readSvg(absSvg) {
  return stripXmlPreamble(fs.readFileSync(absSvg, "utf8"));
}

function indexHtml({ title, intervalMs }) {
  return `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${htmlEscape(title)} - svg-viewer</title>
    <style>
      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        background: #000;
        font-family: system-ui, sans-serif;
      }

      body > svg {
        display: block;
        max-width: none;
        max-height: none;
      }
    </style>
  </head>
  <body>
    <script>
      const intervalMs = ${JSON.stringify(intervalMs)};
      let lastSvg = "";

      async function updateSvg() {
        const response = await fetch("/svg?reload=" + Date.now(), { cache: "no-store" });
        if (!response.ok) {
          throw new Error("SVG request failed: " + response.status);
        }

        const text = await response.text();
        if (text === lastSvg) {
          return;
        }

        const documentSvg = new DOMParser().parseFromString(text, "image/svg+xml");
        const parserError = documentSvg.querySelector("parsererror");
        if (parserError) {
          throw new Error(parserError.textContent || "Unable to parse SVG");
        }

        const nextSvg = document.importNode(documentSvg.documentElement, true);
        const currentSvg = document.body.querySelector(":scope > svg");
        if (currentSvg) {
          currentSvg.replaceWith(nextSvg);
        } else {
          document.body.prepend(nextSvg);
        }
        lastSvg = text;
      }

      updateSvg().catch(console.error);
      setInterval(() => updateSvg().catch(console.error), intervalMs);
    </script>
  </body>
</html>
`;
}

function send(response, status, headers, body) {
  response.writeHead(status, {
    "Cache-Control": "no-store",
    ...headers,
  });
  response.end(body);
}

function startServer(config) {
  const server = http.createServer((request, response) => {
    const requestUrl = new URL(request.url || "/", "http://127.0.0.1");

    if (requestUrl.pathname === "/") {
      send(
        response,
        200,
        { "Content-Type": "text/html; charset=utf-8" },
        indexHtml(config),
      );
      return;
    }

    if (requestUrl.pathname === "/svg") {
      try {
        send(
          response,
          200,
          { "Content-Type": "image/svg+xml; charset=utf-8" },
          readSvg(config.absSvg),
        );
      } catch (error) {
        send(
          response,
          500,
          { "Content-Type": "text/plain; charset=utf-8" },
          error instanceof Error ? error.message : String(error),
        );
      }
      return;
    }

    send(response, 404, { "Content-Type": "text/plain; charset=utf-8" }, "Not found");
  });

  server.listen(config.port, "127.0.0.1", () => {
    fs.writeFileSync(config.readyFile, String(server.address().port));
  });
}

function findOpenPort() {
  return new Promise((resolve, reject) => {
    const server = net.createServer();
    server.on("error", reject);
    server.listen(0, "127.0.0.1", () => {
      const address = server.address();
      server.close(() => resolve(address.port));
    });
  });
}

function openBrowser(url) {
  const candidates = [];

  if (process.env.BROWSER) {
    candidates.push([process.env.BROWSER, [url]]);
  }

  if (process.platform === "darwin") {
    candidates.push(["open", [url]]);
  } else {
    candidates.push(["xdg-open", [url]]);
  }

  for (const [command, args] of candidates) {
    if (!commandExists(command)) {
      continue;
    }

    try {
      const child = spawn(command, args, {
        detached: true,
        stdio: "ignore",
      });
      child.unref();
      return;
    } catch {
      // Try the next opener.
    }
  }

  throw new Error("could not find xdg-open, open, or $BROWSER");
}

function commandExists(command) {
  if (command.includes(path.sep)) {
    return fs.existsSync(command);
  }

  return (process.env.PATH || "")
    .split(path.delimiter)
    .some((dir) => fs.existsSync(path.join(dir, command)));
}

function parseArgs(args) {
  let interval = "1";
  const rest = [...args];

  while (rest.length > 0) {
    const arg = rest[0];
    if (arg === "--interval") {
      if (rest.length < 2) {
        usage();
        process.exit(2);
      }
      interval = rest[1];
      rest.splice(0, 2);
    } else if (arg === "-h" || arg === "--help") {
      usage();
      process.exit(0);
    } else if (arg === "--") {
      rest.shift();
      break;
    } else if (arg.startsWith("-")) {
      console.error(`svg-viewer: unknown option: ${arg}`);
      usage();
      process.exit(2);
    } else {
      break;
    }
  }

  if (rest.length !== 1) {
    usage();
    process.exit(2);
  }

  if (!isPositiveNumber(interval)) {
    console.error("svg-viewer: --interval must be a positive number of seconds");
    process.exit(2);
  }

  return {
    intervalMs: Math.max(100, Number(interval) * 1000),
    svgPath: rest[0],
  };
}

async function waitForReadyFile(readyFile) {
  const started = Date.now();
  while (Date.now() - started < 5000) {
    try {
      return fs.readFileSync(readyFile, "utf8").trim();
    } catch {
      await new Promise((resolve) => setTimeout(resolve, 25));
    }
  }
  throw new Error("timed out waiting for svg-viewer server");
}

async function main() {
  if (process.argv[2] === "--serve") {
    startServer(JSON.parse(process.argv[3]));
    return;
  }

  const { intervalMs, svgPath } = parseArgs(process.argv.slice(2));

  if (!fs.existsSync(svgPath) || !fs.statSync(svgPath).isFile()) {
    console.error(`svg-viewer: file not found: ${svgPath}`);
    process.exit(1);
  }

  if (path.extname(svgPath).toLowerCase() !== ".svg") {
    console.error(`svg-viewer: expected an .svg file: ${svgPath}`);
    process.exit(1);
  }

  const absSvg = fs.realpathSync(svgPath);
  const cacheRoot = process.env.XDG_CACHE_HOME || path.join(os.homedir(), ".cache");
  fs.mkdirSync(cacheRoot, { recursive: true });
  const viewDir = fs.mkdtempSync(path.join(cacheRoot, "svg-viewer-"));
  const readyFile = path.join(viewDir, "port");
  const port = await findOpenPort();
  const config = {
    absSvg,
    intervalMs,
    port,
    readyFile,
    title: path.basename(absSvg),
  };

  const server = spawn(process.execPath, [process.argv[1], "--serve", JSON.stringify(config)], {
    detached: true,
    stdio: "ignore",
  });
  server.unref();

  const actualPort = await waitForReadyFile(readyFile);
  const url = `http://127.0.0.1:${actualPort}/`;

  openBrowser(url);
  console.log(`Opened ${url}`);
}

main().catch((error) => {
  console.error(`svg-viewer: ${error instanceof Error ? error.message : String(error)}`);
  process.exit(1);
});
