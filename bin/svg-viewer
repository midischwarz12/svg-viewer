#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only

set -euo pipefail

usage() {
	cat >&2 <<'EOF'
Usage: svg-viewer [--interval SECONDS] <path-to-svg>

Open an SVG in your preferred browser and refresh it on a timer.
EOF
}

html_escape() {
	local value="$1"
	value="${value//&/&amp;}"
	value="${value//</&lt;}"
	value="${value//>/&gt;}"
	value="${value//\"/&quot;}"
	value="${value//\'/&#39;}"
	printf '%s' "$value"
}

inline_svg() {
	awk '
		/^[[:space:]]*<\?xml[[:space:]]/ { next }
		/^[[:space:]]*<!DOCTYPE[[:space:]]/ {
			if ($0 !~ />[[:space:]]*$/) {
				in_doctype = 1
			}
			next
		}
		in_doctype {
			if ($0 ~ />[[:space:]]*$/) {
				in_doctype = 0
			}
			next
		}
		{ print }
	' "$abs_svg"
}

render_index() {
	local tmp_html="$view_dir/index.html.tmp"

	cat >"$tmp_html" <<EOF
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>$escaped_svg_name - svg-viewer</title>
    <style>
      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        background: #000;
        font-family: system-ui, sans-serif;
      }

      body > svg {
        display: block;
        max-width: none;
        max-height: none;
      }
    </style>
  </head>
  <body>
EOF

	inline_svg >>"$tmp_html"

	cat >>"$tmp_html" <<EOF
    <script>
      const intervalMs = Math.max(100, Number("$interval") * 1000);

      setTimeout(() => {
        location.reload();
      }, intervalMs);
    </script>
  </body>
</html>
EOF
	mv "$tmp_html" "$view_dir/index.html"
}

if [[ "${1:-}" == "--watch-html" ]]; then
	if (($# != 5)); then
		exit 2
	fi

	abs_svg="$2"
	interval="$3"
	view_dir="$4"
	escaped_svg_name="$5"

	while true; do
		sleep "$interval"
		render_index
	done
fi

interval="1"

while (($# > 0)); do
	case "$1" in
	--interval)
		if (($# < 2)); then
			usage
			exit 2
		fi
		interval="$2"
		shift 2
		;;
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		break
		;;
	-*)
		printf 'svg-viewer: unknown option: %s\n' "$1" >&2
		usage
		exit 2
		;;
	*)
		break
		;;
	esac
done

if (($# != 1)); then
	usage
	exit 2
fi

svg_path="$1"

if [[ ! -f "$svg_path" ]]; then
	printf 'svg-viewer: file not found: %s\n' "$svg_path" >&2
	exit 1
fi

case "$svg_path" in
*.svg | *.SVG) ;;
*)
	printf 'svg-viewer: expected an .svg file: %s\n' "$svg_path" >&2
	exit 1
	;;
esac

if ! [[ "$interval" =~ ^[0-9]+([.][0-9]+)?$ ]] || [[ "$interval" == "0" || "$interval" == "0.0" ]]; then
	printf 'svg-viewer: --interval must be a positive number of seconds\n' >&2
	exit 2
fi

abs_svg="$(realpath "$svg_path")"
svg_name="$(basename "$abs_svg")"
escaped_svg_name="$(html_escape "$svg_name")"
cache_root="${XDG_CACHE_HOME:-"$HOME/.cache"}/svg-viewer"
view_dir="$cache_root/$(date +%Y%m%d-%H%M%S)-$$"
mkdir -p "$view_dir"

render_index

nohup "$0" --watch-html "$abs_svg" "$interval" "$view_dir" "$escaped_svg_name" >/dev/null 2>&1 &

open_target="$view_dir/index.html"

if command -v xdg-open >/dev/null 2>&1; then
	xdg-open "$open_target" >/dev/null 2>&1 &
elif command -v open >/dev/null 2>&1; then
	open "$open_target" >/dev/null 2>&1 &
elif [[ -n "${BROWSER:-}" ]]; then
	"$BROWSER" "$open_target" >/dev/null 2>&1 &
else
	printf 'svg-viewer: could not find xdg-open, open, or %s\n' "\$BROWSER" >&2
	printf 'svg-viewer: open this file manually: %s\n' "$open_target" >&2
	exit 1
fi

printf 'Opened %s\n' "$open_target"
